{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "VITE_*"
      ]
    },
    "fluentci-desktop#build": {
      "dependsOn": [
        "fluentci-studio#build"
      ],
      "cache": false,
      "passThroughEnv": [
        "*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "cache": false
    },
    "test:browser": {
      "cache": false
    },
    "@fluentci/docs#build": {
      "outputs": ["_site/**"],
      "env": ["DOCS_URL"]
    },
    "@fluentci/api#build": {
      "outputs": [
        "build/dev/javascript/**"
      ]
    }
  }
}

  #?(:clj (throw (ex-info "Guest imports require Extism" {}))
     :cljs
     (do (codec/validate! schemas {"$ref" "#/components/schemas/Cache" "contentType" "application/json"} value)
     (do (bridge/call! "with_cache" (bridge/json value) false) nil))))


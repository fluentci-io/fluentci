/** Native file tasks; no IO until the plan executes. */
@module("./files_ffi.mjs") external envFile: (Matrix.task, string) => Matrix.task = "envFile"
@module("./files_ffi.mjs") external resultValue: (Matrix.runResult, string) => Nullable.t<JSON.t> = "resultValue"
@module("./files_ffi.mjs") external readText: (string, string, int, string) => Matrix.task = "readText"
@module("./files_ffi.mjs") external readBytes: (string, string, int, string) => Matrix.task = "readBytes"
@module("./files_ffi.mjs") external writeText: (string, string, string, bool, string) => Matrix.task = "writeText"
@module("./files_ffi.mjs") external writeBytes: (string, string, array<int>, bool, string) => Matrix.task = "writeBytes"
@module("./files_ffi.mjs") external copyFile: (string, string, string, bool, string) => Matrix.task = "copyFile"
@module("./files_ffi.mjs") external copyTree: (string, string, string, bool, string) => Matrix.task = "copyTree"
@module("./files_ffi.mjs") external move: (string, string, string, bool, string) => Matrix.task = "move"
@module("./files_ffi.mjs") external mkdir: (string, string, bool, string) => Matrix.task = "mkdir"
@module("./files_ffi.mjs") external remove: (string, string, bool, bool, string) => Matrix.task = "remove"
@module("./files_ffi.mjs") external stat: (string, string, string) => Matrix.task = "stat"
@module("./files_ffi.mjs") external exists: (string, string, string) => Matrix.task = "exists"
@module("./files_ffi.mjs") external list: (string, string, string) => Matrix.task = "list"
@module("./files_ffi.mjs") external glob: (string, string, string) => Matrix.task = "glob"
@module("./files_ffi.mjs") external hash: (string, string, string) => Matrix.task = "hash"
@module("./files_ffi.mjs") external chmod: (string, string, int, string) => Matrix.task = "chmod"
@module("./files_ffi.mjs") external symlink: (string, string, string, string) => Matrix.task = "symlink"

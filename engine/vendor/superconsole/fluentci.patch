--- a/src/stdin.rs
+++ b/src/stdin.rs
@@ -179,0 +180,19 @@
+
+#[cfg(all(test, unix))]
+mod fluentci_bsd_tests {
+    use super::raw_reader::RawReader;
+    use std::io::{Read, Write};
+    use std::os::unix::net::UnixStream;
+
+    #[test]
+    fn raw_reader_preserves_binary_bytes_and_eof_on_unix() {
+        let (input, mut output) = UnixStream::pair().unwrap();
+        let expected = "héllo BSD\0\n".as_bytes();
+        output.write_all(expected).unwrap();
+        drop(output);
+        let mut reader = RawReader::new(input);
+        let mut actual = Vec::new();
+        reader.read_to_end(&mut actual).unwrap();
+        assert_eq!(actual, expected);
+    }
+}

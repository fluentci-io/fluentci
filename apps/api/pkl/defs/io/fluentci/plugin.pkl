amends "../../../schema/lexicon.pkl"

lexicon = 1
id = "io.fluentci.plugin"
description = "A FluentCI Wasm plugin published by its AT Protocol author."
defs = new Mapping {
  ["main"] = new Record {
    key = "any"
    description = "Published Wasm plugin. Package identity is author DID plus name, stable across handle changes. The record key is name-version; author must equal the repository DID. Records are immutable releases."
    `record` = new ObjectField {
      required = List("name", "description", "version", "publishedAt", "author", "license", "url", "sha256", "size")
      properties = new Mapping {
        ["name"] = new StringField {
          minLength = 1
          maxLength = 64
        }
        ["description"] = new StringField {
          maxLength = 2048
        }
        ["version"] = new StringField {
          minLength = 1
          maxLength = 128
        }
        ["publishedAt"] = new StringField {
          format = "datetime"
        }
        ["author"] = new StringField {
          format = "did"
        }
        ["license"] = new StringField {
          minLength = 1
          maxLength = 128
        }
        ["url"] = new StringField {
          format = "uri"
          maxLength = 2048
        }
        ["sha256"] = new StringField {
          minLength = 64
          maxLength = 64
        }
        ["functions"] = new ArrayField {
          description = "Exported jobs with optional source-level signatures and their actual Wasm ABI. Missing args or returnType means unknown, not zero arguments or void."
          items = new RefField { ref = "io.fluentci.plugin#function" }
        }
        ["size"] = new IntegerField {
          minimum = 8
          maximum = 67108864
        }
        ["repository"] = new StringField {
          description = "Optional source Git repository URL."
          format = "uri"
          maxLength = 2048
        }
        ["logo"] = new StringField {
          description = "Optional HTTP(S) picture URL for the module logo."
          format = "uri"
          maxLength = 2048
        }
        ["subdir"] = new StringField {
          description = "Relative module source directory inside the Git repository."
          minLength = 1
          maxLength = 2048
        }
      }
    }
  }
  ["argument"] = new ObjectField {
    required = List("name", "type")
    properties = new Mapping {
      ["name"] = new StringField { minLength = 1
maxLength = 128 }
      ["type"] = new StringField { minLength = 1
maxLength = 1024 }
      ["description"] = new StringField { maxLength = 2048 }
    }
  }
  ["function"] = new ObjectField {
    required = List("name", "wasmParams", "wasmResults")
    properties = new Mapping {
      ["name"] = new StringField { minLength = 1
maxLength = 256 }
      ["description"] = new StringField { maxLength = 2048 }
      ["args"] = new ArrayField { items = new RefField { ref = "io.fluentci.plugin#argument" } }
      ["returnType"] = new StringField { minLength = 1
maxLength = 1024 }
      ["wasmParams"] = new ArrayField { items = new StringField {} }
      ["wasmResults"] = new ArrayField { items = new StringField {} }
    }
  }

}

amends "../../../schema/lexicon.pkl"

id = "io.fluentci.like"
description = "A user's like of a published plugin record. The subject contains the plugin AT URI and CID. Clients use com.atproto.repo.createRecord without a record key, letting the PDS generate its default short key. Delete the like record to unlike."
defs = new Mapping {
  ["main"] = new Record {
    `record` = new ObjectField {
      required = List("subject", "createdAt")
      properties = new Mapping {
        ["subject"] = new RefField { ref = "com.atproto.repo.strongRef" }
        ["createdAt"] = new StringField { format = "datetime" }
      }
    }
  }
}

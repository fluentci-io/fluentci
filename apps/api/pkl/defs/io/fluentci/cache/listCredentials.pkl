amends "../../../../schema/lexicon.pkl"

id = "io.fluentci.cache.listCredentials"
description = "Owner-only: list up to 100 latest CI credentials without secret values."
defs = new Mapping {
  ["main"] = new Procedure {
    input = new Body {
      encoding = "application/json"
      schema = new ObjectField {
        required = List()
        properties = new Mapping {
        }
      }
    }
    output = new Body {
      encoding = "application/json"
      schema = new ObjectField {
        required = List("credentials")
        properties = new Mapping {
          ["credentials"] = new ArrayField {
            items = new RefField {
              ref = "io.fluentci.cache.defs#credentialView"
            }
          }
        }
      }
    }
    errors = List(
      new Error {
        name = "AuthRequired"
      },
      new Error {
        name = "CacheUnavailable"
      }
    )
  }
}

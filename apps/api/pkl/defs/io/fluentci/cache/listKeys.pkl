amends "../../../../schema/lexicon.pkl"

id = "io.fluentci.cache.listKeys"
description = "Owner-only cache management. Requires a method-scoped service-auth token."
defs = new Mapping {
 ["main"] = new Procedure {
  input = new Body {
   encoding = "application/json"
   schema = new ObjectField {
    required = List()
    properties = new Mapping {
     ["prefix"] = new StringField { maxLength = 2048 }
["cursor"] = new StringField { maxLength = 2048 }
["limit"] = new IntegerField { minimum = 1
 maximum = 200 }
    }
   }
  }
  output = new Body {
   encoding = "application/json"
   schema = new ObjectField {
    required = List("keys", "totalBytes", "totalKeys")
    properties = new Mapping {
     ["keys"] = new ArrayField { items = new RefField { ref = "io.fluentci.cache.defs#keyView" } }
["cursor"] = new StringField {}
["totalBytes"] = new IntegerField { minimum = 0 }
["totalKeys"] = new IntegerField { minimum = 0 }
    }
   }
  }
  errors = List(new Error { name = "AuthRequired" }, new Error { name = "CacheUnavailable" }, new Error { name = "InvalidRequest" })
 }
}

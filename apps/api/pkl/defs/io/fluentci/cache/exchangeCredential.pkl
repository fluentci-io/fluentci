amends "../../../../schema/lexicon.pkl"

id = "io.fluentci.cache.exchangeCredential"
description = "Exchange a CI credential in the Authorization bearer header for a non-expiring owner-scoped upload token. No PDS login is required."
defs = new Mapping {
  ["main"] = new Procedure {
    input = new Body {
      encoding = "application/json"
      schema = new ObjectField {
        required = List()
        properties = new Mapping {
        }
      }
    }
    output = new Body {
      encoding = "application/json"
      schema = new ObjectField {
        required = List("id", "token", "cacheUrl", "owner")
        properties = new Mapping {
          ["id"] = new StringField {}
          ["token"] = new StringField {
          }
          ["expiresAt"] = new StringField {
            format = "datetime"
          }
          ["cacheUrl"] = new StringField {
            format = "uri"
          }
          ["owner"] = new StringField {
            format = "did"
          }
        }
      }
    }
    errors = List(
      new Error {
        name = "AuthRequired"
      },
      new Error {
        name = "CacheUnavailable"
      }
    )
  }
}

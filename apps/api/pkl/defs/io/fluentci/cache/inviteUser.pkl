amends "../../../../schema/lexicon.pkl"

id = "io.fluentci.cache.inviteUser"
description = "Grant an account upload access to your cache. Requires an account service-auth JWT addressed to this method. Reads remain public."
defs = new Mapping {
  ["main"] = new Procedure {
    input = new Body {
      encoding = "application/json"
      schema = new ObjectField {
        required = List("actor")
        properties = new Mapping {
          ["actor"] = new StringField { format = "at-identifier" }
        }
      }
    }
    output = new Body {
      encoding = "application/json"
      schema = new ObjectField {
        required = List("owner", "actor", "active")
        properties = new Mapping {
          ["owner"] = new StringField { format = "did" }
          ["actor"] = new StringField { format = "did" }
          ["active"] = new BooleanField {}
        }
      }
    }
    errors = List(
      new Error { name = "AuthRequired" },
      new Error { name = "AccessDenied" },
      new Error { name = "CacheUnavailable" }
    )
  }
}

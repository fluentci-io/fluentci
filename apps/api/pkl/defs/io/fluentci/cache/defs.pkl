amends "../../../../schema/lexicon.pkl"

id = "io.fluentci.cache.defs"
defs = new Mapping {
  ["credentialView"] = new ObjectField {
    required = List("id", "label", "createdAt", "expiresAt", "active")
    properties = new Mapping {
      ["id"] = new StringField {
      }
      ["label"] = new StringField {
      }
      ["createdAt"] = new StringField {
        format = "datetime"
      }
      ["expiresAt"] = new StringField {
        format = "datetime"
      }
      ["active"] = new BooleanField {
      }
    }
  }
 ["keyView"] = new ObjectField {
 required = List("key", "size", "lastModified")
 properties = new Mapping {
  ["key"] = new StringField {}
  ["size"] = new IntegerField { minimum = 0 }
  ["lastModified"] = new StringField { format = "datetime" }
 }
 }
  ["protocolUsage"] = new ObjectField {
    required = List("protocol", "bytes", "keyCount")
    properties = new Mapping {
      ["protocol"] = new StringField {}
      ["bytes"] = new IntegerField { minimum = 0 }
      ["keyCount"] = new IntegerField { minimum = 0 }
    }
  }
  ["usageSample"] = new ObjectField {
    required = List("date", "bytes", "keyCount", "observedAt")
    properties = new Mapping {
      ["date"] = new StringField { minLength = 10
 maxLength = 10 }
      ["bytes"] = new IntegerField { minimum = 0 }
      ["keyCount"] = new IntegerField { minimum = 0 }
      ["observedAt"] = new StringField { format = "datetime" }
      ["protocols"] = new ArrayField { items = new RefField { ref = "io.fluentci.cache.defs#protocolUsage" } }
    }
  }
  ["uploadTokenView"] = new ObjectField {
    required = List("id", "owner", "actor", "createdAt", "active")
    properties = new Mapping {
      ["id"] = new StringField {}
      ["owner"] = new StringField { format = "did" }
      ["actor"] = new StringField { format = "did" }
      ["createdAt"] = new StringField { format = "datetime" }
      ["expiresAt"] = new StringField { format = "datetime" }
      ["active"] = new BooleanField {}
    }
  }
}

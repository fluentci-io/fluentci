amends "../../../../schema/lexicon.pkl"

id = "io.fluentci.cache.createCredential"
description = "Owner-only: create a 90-day revocable CI credential. The secret is returned once."
defs = new Mapping {
  ["main"] = new Procedure {
    input = new Body {
      encoding = "application/json"
      schema = new ObjectField {
        required = List("label")
        properties = new Mapping {
          ["label"] = new StringField {
            minLength = 1
            maxLength = 80
          }
        }
      }
    }
    output = new Body {
      encoding = "application/json"
      schema = new ObjectField {
        required = List("id", "label", "createdAt", "expiresAt", "active", "credential", "owner")
        properties = new Mapping {
          ["id"] = new StringField {
          }
          ["label"] = new StringField {
          }
          ["createdAt"] = new StringField {
            format = "datetime"
          }
          ["expiresAt"] = new StringField {
            format = "datetime"
          }
          ["active"] = new BooleanField {
          }
          ["credential"] = new StringField {
          }
          ["owner"] = new StringField {
            format = "did"
          }
        }
      }
    }
    errors = List(
      new Error {
        name = "AuthRequired"
      },
      new Error {
        name = "CacheUnavailable"
      }
    )
  }
}

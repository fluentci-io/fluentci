amends "../../../../schema/lexicon.pkl"

id = "io.fluentci.cache.createToken"
description = "Issue a non-expiring upload token for your cache, or a cache whose owner invited you. Requires an account service-auth JWT addressed to this method. Reads remain public."
defs = new Mapping {
  ["main"] = new Procedure {
    input = new Body {
      encoding = "application/json"
      schema = new ObjectField {
        required = List()
        properties = new Mapping {
          ["owner"] = new StringField { format = "at-identifier" }
        }
      }
    }
    output = new Body {
      encoding = "application/json"
      schema = new ObjectField {
        required = List("id", "token", "cacheUrl", "owner")
        properties = new Mapping {
          ["id"] = new StringField {}
          ["token"] = new StringField {}
          ["expiresAt"] = new StringField { format = "datetime" }
          ["cacheUrl"] = new StringField { format = "uri" }
          ["owner"] = new StringField { format = "did" }
        }
      }
    }
    errors = List(
      new Error { name = "AuthRequired" },
      new Error { name = "AccessDenied" },
      new Error { name = "CacheUnavailable" }
    )
  }
}

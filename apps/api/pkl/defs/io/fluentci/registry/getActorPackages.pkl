amends "../../../../schema/lexicon.pkl"

lexicon = 1
id = "io.fluentci.registry.getActorPackages"
description = "List an actor's indexed published plugin versions, newest first, using cursor pagination."
defs = new Mapping {
  ["main"] = new Query {
    parameters = new Parameters {
      required = List("actor")
      properties = new Mapping {
        ["actor"] = new StringField {
          format = "at-identifier"
        }
        ["limit"] = new IntegerField {
          minimum = 1
          maximum = 100
          default = 20
        }
        ["cursor"] = new StringField {
          maxLength = 4096
        }
      }
    }
    output = new Body {
      encoding = "application/json"
      schema = new ObjectField {
        required = List("packages")
        properties = new Mapping {
          ["packages"] = new ArrayField {
            items = new RefField {
              ref = "io.fluentci.registry.defs#packageView"
            }
          }
          ["cursor"] = new StringField {
          }
        }
      }
    }
    errors = List(new Error {
      name = "InvalidCursor"
      description = "The cursor is invalid or belongs to a different query."
    })
  }
}

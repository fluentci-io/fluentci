amends "../../../../schema/lexicon.pkl"

lexicon = 1
id = "io.fluentci.registry.searchPackages"
description = "Full-text search plugin names and descriptions, with token prefix matching."
defs = new Mapping {
  ["main"] = new Query {
    parameters = new Parameters {
      required = List()
      properties = new Mapping {
        ["latest"] = new BooleanField {
          description = "Return only the highest stable SemVer release per author and name, or highest prerelease when no stable release exists. Applied before filtering, sorting and pagination."
        }
        ["sort"] = new StringField {
          `enum` = List("downloads", "newest", "oldest", "name")
          description = "Sort by downloads (default), newest publication, oldest publication, or module name A-Z."
        }
        ["limit"] = new IntegerField {
          minimum = 1
          maximum = 100
          default = 20
        }
        ["cursor"] = new StringField {
          maxLength = 4096
        }
        ["author"] = new StringField {
          format = "at-identifier"
        }
        ["filter"] = new StringField {
          maxLength = 2048
          description = "RSQL filter: os==linux;arch=in=(aarch64,x86_64). Fields: name, version, license, author (DID), os, arch, topics. Operators: ==, !=, =in=, =out=; AND (;), OR (,), grouping."
        }
        ["q"] = new StringField {
          maxLength = 200
        }
      }
    }
    output = new Body {
      encoding = "application/json"
      schema = new ObjectField {
        required = List("packages")
        properties = new Mapping {
          ["packages"] = new ArrayField {
            items = new RefField {
              ref = "io.fluentci.registry.defs#packageView"
            }
          }
          ["total"] = new IntegerField {
            minimum = 0
            description = "Number of matching visible modules before cursor pagination; counts latest releases only when latest is true."
          }
          ["cursor"] = new StringField {
          }
        }
      }
    }
    errors = List(new Error { name = "InvalidFilter" }, new Error {
      name = "InvalidCursor"
      description = "The cursor is invalid or belongs to a different query."
    })
  }
}

        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "samples"
          ],
          "properties": {
            "samples": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "io.fluentci.cache.defs#usageSample"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthRequired"
        }
      ]
    }
  }

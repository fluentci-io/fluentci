{
  "lexicon": 1,
  "id": "io.fluentci.cache.listTokens",
  "description": "Owner-only cache management. Requires a method-scoped service-auth token.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [],
          "properties": {
            "cursor": {
              "type": "string",
              "maxLength": 2048
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "tokens"
          ],
          "properties": {
            "tokens": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "io.fluentci.cache.defs#uploadTokenView"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthRequired"
        },
        {
          "name": "CacheUnavailable"
        },
        {
          "name": "InvalidRequest"
        }
      ]
    }
  }
}

{
  "lexicon": 1,
  "id": "io.fluentci.cache.createCredential",
  "description": "Owner-only: create a 90-day revocable CI credential. The secret is returned once.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "id",
            "label",
            "createdAt",
            "expiresAt",
            "active",
            "credential",
            "owner"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "createdAt": {
              "type": "string",
              "format": "datetime"
            },
            "expiresAt": {
              "type": "string",
              "format": "datetime"
            },
            "active": {
              "type": "boolean"
            },
            "credential": {
              "type": "string"
            },
            "owner": {
              "type": "string",
              "format": "did"
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthRequired"
        },
        {
          "name": "CacheUnavailable"
        }
      ]
    }
  }
}

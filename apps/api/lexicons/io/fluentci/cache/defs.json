{
  "lexicon": 1,
  "id": "io.fluentci.cache.defs",
  "defs": {
    "credentialView": {
      "type": "object",
      "required": [
        "id",
        "label",
        "createdAt",
        "expiresAt",
        "active"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "expiresAt": {
          "type": "string",
          "format": "datetime"
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "keyView": {
      "type": "object",
      "required": [
        "key",
        "size",
        "lastModified"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "lastModified": {
          "type": "string",
          "format": "datetime"
        }
      }
    },
    "usageSample": {
      "type": "object",
      "required": [
        "date",
        "bytes",
        "keyCount",
        "observedAt"
      ],
      "properties": {
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "keyCount": {
          "type": "integer",
          "minimum": 0
        },
        "observedAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    }
  }
}

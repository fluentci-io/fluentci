{
  "lexicon": 1,
  "id": "io.fluentci.cache.listKeys",
  "description": "Owner-only cache management. Requires a method-scoped service-auth token.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [],
          "properties": {
            "prefix": {
              "type": "string",
              "maxLength": 2048
            },
            "cursor": {
              "type": "string",
              "maxLength": 2048
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "keys",
            "totalBytes",
            "totalKeys"
          ],
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "io.fluentci.cache.defs#keyView"
              }
            },
            "cursor": {
              "type": "string"
            },
            "totalBytes": {
              "type": "integer",
              "minimum": 0
            },
            "totalKeys": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthRequired"
        },
        {
          "name": "CacheUnavailable"
        },
        {
          "name": "InvalidRequest"
        }
      ]
    }
  }
}

{
  "lexicon": 1,
  "id": "io.fluentci.cache.revokeCredential",
  "description": "Owner-only: disable a CI credential. Already-issued upload tokens remain valid until individually revoked.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "revoked"
          ],
          "properties": {
            "revoked": {
              "type": "boolean"
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthRequired"
        },
        {
          "name": "CacheUnavailable"
        }
      ]
    }
  }
}

{
  "lexicon": 1,
  "id": "io.fluentci.cache.createToken",
  "description": "Issue a one-hour upload token for your cache, or a cache whose owner invited you. Requires an account service-auth JWT addressed to this method. Reads remain public.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [],
          "properties": {
            "owner": {
              "type": "string",
              "format": "at-identifier"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "id",
            "token",
            "expiresAt",
            "cacheUrl",
            "owner"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "token": {
              "type": "string"
            },
            "expiresAt": {
              "type": "string",
              "format": "datetime"
            },
            "cacheUrl": {
              "type": "string",
              "format": "uri"
            },
            "owner": {
              "type": "string",
              "format": "did"
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthRequired"
        },
        {
          "name": "AccessDenied"
        },
        {
          "name": "CacheUnavailable"
        }
      ]
    }
  }
}

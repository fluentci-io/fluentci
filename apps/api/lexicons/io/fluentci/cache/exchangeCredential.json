{
  "lexicon": 1,
  "id": "io.fluentci.cache.exchangeCredential",
  "description": "Exchange a CI credential in the Authorization bearer header for a non-expiring owner-scoped upload token. No PDS login is required.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [],
          "properties": {}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "id",
            "token",
            "cacheUrl",
            "owner"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "token": {
              "type": "string"
            },
            "expiresAt": {
              "type": "string",
              "format": "datetime"
            },
            "cacheUrl": {
              "type": "string",
              "format": "uri"
            },
            "canonicalCacheUrl": {
              "type": "string",
              "format": "uri"
            },
            "owner": {
              "type": "string",
              "format": "did"
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthRequired"
        },
        {
          "name": "CacheUnavailable"
        }
      ]
    }
  }
}

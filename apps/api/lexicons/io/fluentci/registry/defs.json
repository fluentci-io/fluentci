{
  "lexicon": 1,
  "id": "io.fluentci.registry.defs",
  "description": "Indexed plugin metadata with its repository record URI and CID.",
  "defs": {
    "packageView": {
      "type": "object",
      "required": [
        "name",
        "description",
        "version",
        "publishedAt",
        "author",
        "license",
        "url",
        "sha256",
        "size",
        "uri",
        "cid"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "maxLength": 2048
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "publishedAt": {
          "type": "string",
          "format": "datetime"
        },
        "author": {
          "type": "string",
          "format": "did"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "functions": {
          "type": "array",
          "description": "Exported jobs with optional source-level signatures and their actual Wasm ABI. Missing args or returnType means unknown, not zero arguments or void.",
          "items": {
            "type": "ref",
            "ref": "io.fluentci.plugin#function"
          }
        },
        "size": {
          "type": "integer",
          "minimum": 8,
          "maximum": 67108864
        },
        "repository": {
          "type": "string",
          "description": "Optional source Git repository URL.",
          "maxLength": 2048,
          "format": "uri"
        },
        "subdir": {
          "type": "string",
          "description": "Relative module source directory inside the Git repository.",
          "minLength": 1,
          "maxLength": 2048
        },
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "cid": {
          "type": "string",
          "format": "cid"
        }
      }
    }
  }
}

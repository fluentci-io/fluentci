{
  "lexicon": 1,
  "id": "io.fluentci.registry.listPackages",
  "description": "List indexed package versions using cursor pagination.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [],
        "properties": {
          "sort": {
            "type": "string",
            "description": "Sort by downloads (default), newest publication, oldest publication, or module name A-Z.",
            "enum": [
              "downloads",
              "newest",
              "oldest",
              "name"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "cursor": {
            "type": "string",
            "maxLength": 4096
          },
          "author": {
            "type": "string",
            "format": "at-identifier"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "packages"
          ],
          "properties": {
            "packages": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "io.fluentci.registry.defs#packageView"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidCursor",
          "description": "The cursor is invalid or belongs to a different query."
        }
      ]
    }
  }
}

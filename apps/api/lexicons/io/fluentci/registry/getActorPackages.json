{
  "lexicon": 1,
  "id": "io.fluentci.registry.getActorPackages",
  "description": "List an actor's indexed published plugin versions, newest first, using cursor pagination.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "actor"
        ],
        "properties": {
          "actor": {
            "type": "string",
            "format": "at-identifier"
          },
          "q": {
            "type": "string",
            "maxLength": 1000
          },
          "latest": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "cursor": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "packages"
          ],
          "properties": {
            "packages": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "io.fluentci.registry.defs#packageView"
              }
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidCursor",
          "description": "The cursor is invalid or belongs to a different query."
        }
      ]
    }
  }
}

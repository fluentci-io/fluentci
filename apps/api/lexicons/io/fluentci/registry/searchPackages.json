{
  "lexicon": 1,
  "id": "io.fluentci.registry.searchPackages",
  "description": "Full-text search plugin names and descriptions, with token prefix matching.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "cursor": {
            "type": "string",
            "maxLength": 4096
          },
          "author": {
            "type": "string",
            "format": "at-identifier"
          },
          "filter": {
            "type": "string",
            "description": "RSQL filter: os==linux;arch=in=(aarch64,x86_64). Fields: name, version, license, author (DID), os, arch, topics. Operators: ==, !=, =in=, =out=; AND (;), OR (,), grouping.",
            "maxLength": 2048
          },
          "q": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "packages"
          ],
          "properties": {
            "packages": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "io.fluentci.registry.defs#packageView"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidFilter"
        },
        {
          "name": "InvalidCursor",
          "description": "The cursor is invalid or belongs to a different query."
        }
      ]
    }
  }
}

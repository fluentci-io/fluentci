{
  "lexicon": 1,
  "id": "io.fluentci.plugin",
  "description": "A FluentCI Wasm plugin published by its AT Protocol author.",
  "defs": {
    "main": {
      "type": "record",
      "description": "Published Wasm plugin. Package identity is author DID plus name, stable across handle changes. The record key is name-version; author must equal the repository DID. Records are immutable releases.",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "name",
          "description",
          "version",
          "publishedAt",
          "author",
          "license",
          "url",
          "sha256",
          "size"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "maxLength": 2048
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "publishedAt": {
            "type": "string",
            "format": "datetime"
          },
          "author": {
            "type": "string",
            "format": "did"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "functions": {
            "type": "array",
            "description": "Exported jobs with optional source-level signatures and their actual Wasm ABI. Missing args or returnType means unknown, not zero arguments or void.",
            "items": {
              "type": "ref",
              "ref": "io.fluentci.plugin#function"
            }
          },
          "size": {
            "type": "integer",
            "minimum": 8,
            "maximum": 67108864
          }
        }
      }
    },
    "argument": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "description": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "function": {
      "type": "object",
      "required": [
        "name",
        "wasmParams",
        "wasmResults"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 2048
        },
        "args": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "io.fluentci.plugin#argument"
          }
        },
        "returnType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "wasmParams": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wasmResults": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

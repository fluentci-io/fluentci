{
  "lexicon": 1,
  "id": "io.fluentci.plugin",
  "description": "A FluentCI Wasm plugin published by its AT Protocol author.",
  "defs": {
    "main": {
      "type": "record",
      "description": "Published Wasm plugin. Package identity is author DID plus name, stable across handle changes. The record key is name-version; author must equal the repository DID. Authors may update metadata on an existing name-version record.",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "name",
          "description",
          "version",
          "publishedAt",
          "author",
          "license",
          "url",
          "sha256",
          "size"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "maxLength": 2048
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "publishedAt": {
            "type": "string",
            "format": "datetime"
          },
          "author": {
            "type": "string",
            "format": "did"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "functions": {
            "type": "array",
            "description": "Exported jobs with optional source-level signatures and their actual Wasm ABI. Missing args or returnType means unknown, not zero arguments or void.",
            "items": {
              "type": "ref",
              "ref": "io.fluentci.plugin#function"
            }
          },
          "size": {
            "type": "integer",
            "minimum": 8,
            "maximum": 67108864
          },
          "repository": {
            "type": "string",
            "description": "Optional source Git repository URL.",
            "maxLength": 2048,
            "format": "uri"
          },
          "logo": {
            "type": "string",
            "description": "Optional HTTP(S) picture URL for the module logo.",
            "maxLength": 2048,
            "format": "uri"
          },
          "subdir": {
            "type": "string",
            "description": "Relative module source directory inside the Git repository.",
            "minLength": 1,
            "maxLength": 2048
          },
          "topics": {
            "type": "array",
            "description": "Optional lowercase topic labels describing the module.",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            "maxLength": 20
          },
          "readmeUrl": {
            "type": "string",
            "description": "Optional public HTTP(S) URL of the module README.",
            "maxLength": 2048,
            "format": "uri"
          },
          "os": {
            "type": "array",
            "description": "Optional supported host operating systems, such as linux, macos, freebsd, netbsd, openbsd, or windows. Omitted means unspecified.",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "maxLength": 16
          },
          "arch": {
            "type": "array",
            "description": "Optional supported host CPU architectures, such as x86_64 or aarch64. Omitted means unspecified.",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "maxLength": 16
          }
        }
      }
    },
    "argument": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "description": {
          "type": "string",
          "maxLength": 2048
        },
        "required": {
          "type": "boolean",
          "description": "Defaults to true. False means the JSON input may omit this field."
        }
      }
    },
    "function": {
      "type": "object",
      "required": [
        "name",
        "wasmParams",
        "wasmResults"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 2048
        },
        "args": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "io.fluentci.plugin#argument"
          }
        },
        "returnType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "wasmParams": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wasmResults": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputFormat": {
          "type": "string",
          "description": "Defaults to legacy text. json opts into the SDK-neutral typed named-argument object protocol.",
          "enum": [
            "text",
            "json"
          ]
        }
      }
    }
  }
}

HOST=127.0.0.1
PORT=3001
DATABASE_URL=file:./data/registry.sqlite
# This DID must match FLUENTCI_REGISTRY_DID in publishing clients.
SERVICE_DID=did:web:api.fluentci.io
# Defaults to all four public US East/West instances. Override with a comma-separated list.
# JETSTREAM_URLS=wss://jetstream1.us-east.bsky.network/subscribe,wss://jetstream1.us-west.bsky.network/subscribe
# JETSTREAM_URL is also supported as a legacy single-instance override.
JETSTREAM_ENABLED=true
# The bucket must expose objects through this public download origin.
S3_BUCKET=fluentci-plugins
S3_REGION=us-east-1
S3_PUBLIC_URL=https://plugins.fluentci.io
# Optional for S3-compatible services (R2, MinIO, etc.)
# S3_ENDPOINT=https://your-s3-endpoint.example
# S3_FORCE_PATH_STYLE=true
# Use the AWS credential provider chain; never put real credentials in source.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Shared ONLY with the apps/modules Worker. Optional; unset disables recording.
# Generate with: openssl rand -hex 32
# DOWNLOAD_TRACKING_TOKEN=

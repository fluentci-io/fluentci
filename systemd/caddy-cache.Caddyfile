# Add to /pds/caddy/etc/caddy/Caddyfile on the production host.
# The Caddy container uses host networking.
cache.fluentci.io {
    # Accept plain handles on older cache binaries as well; keep the public URL.
    @plainCacheHandle path_regexp plainCacheHandle ^/([A-Za-z0-9][A-Za-z0-9.-]*\.[A-Za-z][A-Za-z0-9.-]*)(/.*)$
    rewrite @plainCacheHandle /@{re.plainCacheHandle.1}{re.plainCacheHandle.2}
    @grpc header Content-Type application/grpc*
    handle @grpc {
        reverse_proxy h2c://127.0.0.1:8080
    }
    handle {
        reverse_proxy 127.0.0.1:8080
    }
}

# REQUIRED: generate a long random administrator secret, e.g. openssl rand -hex 32.
# Used for operations endpoints and legacy shared-cache writes. Never give it to users.
# FLUENTCI_CACHE_TOKEN=replace-with-random-secret

# S3 writes: use a machine role or set credentials here (no shell quoting/expansion).
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
# AWS_SESSION_TOKEN=optional-session-token

# Enable upload JWTs minted by the FluentCI API. Public key only on this server.
# FLUENTCI_CACHE_UPLOAD_TOKEN_PUBLIC_KEY_FILE=/etc/fluentci/cache-upload-public.pem
# FLUENTCI_CACHE_UPLOAD_TOKEN_ISSUER=did:web:api.fluentci.io
RUST_LOG=fluentci_cache=info
